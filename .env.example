# Application
SECRET_KEY=change-me-to-a-random-secret-key-at-least-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database
POSTGRES_DB=audio_separation
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password
DATABASE_URL=postgresql+asyncpg://postgres:your_postgres_password@localhost:5433/audio_separation

# Redis / Celery
REDIS_URL=redis://localhost:6380/0
CELERY_BROKER_URL=redis://localhost:6380/0
CELERY_RESULT_BACKEND=redis://localhost:6380/1

# MinIO Object Storage
MINIO_ENDPOINT=localhost:9002
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET_INPUT=audio-input
MINIO_BUCKET_OUTPUT=audio-output
MINIO_SECURE=false

# Model Serving
MODEL_SERVING_URL=http://localhost:8001
MODEL_DIR=/models

# Logging
LOG_LEVEL=INFO

# CORS
CORS_ORIGINS=http://localhost,http://localhost:3000

# Credits
DEFAULT_USER_CREDITS=10
PROMO_CODES={"WELCOME10":10,"BONUS5":5}

# File upload limits
MAX_UPLOAD_SIZE_MB=50
